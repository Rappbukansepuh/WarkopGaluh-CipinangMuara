# =============================================================
# WARKOP APP - Environment Variables Template
# Copy file ini menjadi .env.local dan isi dengan nilai asli
# Untuk Vercel: set semua variabel ini di Settings > Environment Variables
# =============================================================

# MongoDB Atlas Connection URI (WAJIB untuk production)
# Buat akun di https://cloud.mongodb.com, lalu buat cluster gratis
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/warkop_db?retryWrites=true&w=majority

# NextAuth Configuration (WAJIB)
# Generate secret dengan: openssl rand -base64 32
NEXTAUTH_SECRET=isi-dengan-string-acak-minimal-32-karakter

# URL aplikasi (WAJIB - isi dengan URL Vercel setelah deploy)
# Contoh: https://warkop-app.vercel.app
NEXTAUTH_URL=https://your-project-name.vercel.app

# Cloudinary Configuration (Opsional - untuk upload gambar)
# Buat akun di https://cloudinary.com (free tier tersedia)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Default Admin Credentials (Opsional - default sudah ada di code)
ADMIN_DEFAULT_EMAIL=admin@warkop.com
ADMIN_DEFAULT_PASSWORD=adminwarkop123
